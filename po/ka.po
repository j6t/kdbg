msgid "Command"
msgstr "ბრძანება"

#. i18n: file: procattachbase.ui:72
#. i18n: ectx: property (text), widget (QTreeWidget, processList)
msgid "PID"
msgstr "PID"

#. i18n: file: procattachbase.ui:77
